VITE_API_URL=/api/v1
# Em produção, configure a URL do servidor Socket.IO e CORS no backend.
VITE_SOCKET_URL=
VITE_MAPA_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Atribuição obrigatória; ajuste ao trocar o provedor.
VITE_MAPA_ATRIBUICAO=&copy; OpenStreetMap contributors
# Ative apenas quando a API contiver dados de estudo/seed. Não gera dados no frontend.
VITE_AMBIENTE_DEMONSTRACAO=false
